rules_version = '2';

// Everything is denied unless a rule below allows it.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    // Per-user files: users/{uid}/... (max 10 MB per upload).
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Profile photos: avatars/{uid}/{file}, resized in the browser before upload.
    // They're displayed through their download URL (which carries an access token and
    // bypasses these rules), so anyone the URL is shared with can see the picture.
    match /avatars/{uid}/{fileName} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|png|jpeg)');
    }
  }
}
