rules_version = '2';

// Everything is denied unless a rule below allows it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The app requires a verified email to use protected pages; enforce the same here.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    // Per-user documents: users/{uid} and anything nested under it.
    // (Jobs used to live in users/{uid}/jobs; the app moves them to /jobs on first load.)
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Basic shape checks for a job (see app/utils/jobs.ts). Jobs moved from the old location
    // may predate tags, so `tags` is only checked when present.
    function isValidJob(job) {
      return job.title is string && job.title.size() > 0 && job.title.size() <= 100
        && job.description is string && job.description.size() <= 5000
        && (!('tags' in job) || (job.tags is list && job.tags.size() <= 5))
        && job.status == 'open';
    }

    // Jobs: one top-level collection, each job with an `owner` field holding the poster's uid.
    // Any verified user can read open jobs ("Find work"); the owner can also read their own
    // jobs in any status. Only the owner can change or delete a job.
    function canReadJob(job) {
      return job.owner == request.auth.uid || job.status == 'open';
    }

    match /jobs/{jobId} {
      // `resource == null`: reading a job that doesn't exist just reports it missing.
      allow get: if isVerified() && (resource == null || canReadJob(resource.data));
      // Listing is only allowed for queries filtered to owner == your uid or status == 'open'.
      allow list: if isVerified() && canReadJob(resource.data);
      allow create: if isOwner(request.resource.data.owner) && isValidJob(request.resource.data);
      allow update: if isOwner(resource.data.owner)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidJob(request.resource.data);
      allow delete: if isOwner(resource.data.owner);

      // Applications: jobs/{jobId}/applications/{applicantUid}, one per user per job.
      // Readable by the applicant and the job's owner only.
      match /applications/{applicantId} {
        function job() {
          return get(/databases/$(database)/documents/jobs/$(jobId)).data;
        }

        // The applicant can check (get) their own application even before it exists.
        allow get: if isOwner(applicantId) || (isVerified() && job().owner == request.auth.uid);
        allow list: if isVerified() && job().owner == request.auth.uid;
        // Apply: verified, to an open job that isn't your own, with your real email.
        allow create: if isOwner(applicantId)
          && job().status == 'open'
          && job().owner != request.auth.uid
          && request.resource.data.keys().hasOnly(['applicant', 'name', 'email', 'message', 'status', 'createdAt'])
          && request.resource.data.applicant == applicantId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        // Accept / reject / undo: the job's owner may change only `status` and `decidedAt`.
        allow update: if isVerified() && job().owner == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
          && request.resource.data.status in ['pending', 'accepted', 'rejected']
          && (request.resource.data.status == 'pending'
            ? request.resource.data.decidedAt == null
            : request.resource.data.decidedAt == request.time);
        // Withdraw (applicant) or clean up before deleting the job (owner).
        allow delete: if isOwner(applicantId) || (isVerified() && job().owner == request.auth.uid);
      }
    }
  }
}
